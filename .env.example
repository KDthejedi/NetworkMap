# Local Postgres (docker compose)
DATABASE_URL=postgres://networkmap:networkmap@localhost:5432/networkmap
DATABASE_URL_DIRECT=postgres://networkmap:networkmap@localhost:5432/networkmap

# Supabase Auth. Create a free project at supabase.com or run a local Supabase stack.
# RLS in this app uses verified Supabase JWTs. The service role key is used only for admin paths.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic (agent layer, spec section 6.2). Use claude-sonnet-4-7 by default.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-7

# Geocoding. Mapbox preferred; falls back to Nominatim if absent.
MAPBOX_ACCESS_TOKEN=

# Web push (spec section 3.7).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Cron secret. Required by /api/cron/* endpoints.
CRON_SECRET=change-me-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
